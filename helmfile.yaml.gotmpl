helmDefaults:
  wait: true
  timeout: 600
  atomic: true
  createNamespace: true
  # This stack uses standard Ingress only; do not install Traefik's cluster-wide CRDs.
  skipCRDs: true

repositories:
  - name: traefik
    url: https://traefik.github.io/charts

environments:
  int:
    values:
      - deploy/environments/int.yaml
  dev:
    values:
      - deploy/environments/dev.yaml
  stg:
    values:
      - deploy/environments/stg.yaml
  prd:
    values:
      - deploy/environments/prd.yaml

---
releases:
  - name: support-ticket-portal-{{ .Environment.Name }}-traefik
    namespace: {{ env "PORTAL_NAMESPACE" | default (printf "support-ticket-portal-%s" .Environment.Name) }}
    chart: traefik/traefik
    version: 41.2.0
    installed: {{ .Values.traefik.install }}
    values:
      - ingressClass:
          enabled: true
          isDefaultClass: false
          name: {{ .Values.traefik.bundledIngressClass | quote }}
        providers:
          kubernetesCRD:
            enabled: false
          kubernetesIngress:
            enabled: true
            ingressClass: {{ .Values.traefik.bundledIngressClass | quote }}
            namespaces:
              - {{ env "PORTAL_NAMESPACE" | default (printf "support-ticket-portal-%s" .Environment.Name) | quote }}
        rbac:
          enabled: true
          # IngressClass is cluster-scoped, so the controller needs ClusterRole access.
          # Resource watching remains limited by providers.kubernetesIngress.namespaces.
          namespaced: false
        service:
          spec:
            type: {{ .Values.traefik.serviceType | quote }}

  - name: support-ticket-portal-{{ .Environment.Name }}
    namespace: {{ env "PORTAL_NAMESPACE" | default (printf "support-ticket-portal-%s" .Environment.Name) }}
    chart: ./deploy/chart
    {{- if .Values.traefik.install }}
    needs:
      - {{ env "PORTAL_NAMESPACE" | default (printf "support-ticket-portal-%s" .Environment.Name) }}/support-ticket-portal-{{ .Environment.Name }}-traefik
    {{- end }}
    values:
      - deploy/environments/{{ .Environment.Name }}.yaml
      - environment: {{ .Environment.Name | quote }}
        blueGreen:
          phase: {{ env "PORTAL_BLUE_GREEN_PHASE" | default "active" | quote }}
        app:
          testUsers:
            usernamePrefix: {{ .Environment.Name | quote }}
        ingress:
          className: {{ if .Values.traefik.install }}{{ .Values.traefik.bundledIngressClass | quote }}{{ else }}{{ .Values.traefik.externalIngressClass | quote }}{{ end }}
        redmineIngress:
          className: {{ if .Values.traefik.install }}{{ .Values.traefik.bundledIngressClass | quote }}{{ else }}{{ .Values.traefik.externalIngressClass | quote }}{{ end }}
        backendIngress:
          className: {{ if .Values.traefik.install }}{{ .Values.traefik.bundledIngressClass | quote }}{{ else }}{{ .Values.traefik.externalIngressClass | quote }}{{ end }}
        secrets:
          redmineApiKey: {{ requiredEnv "REDMINE_API_KEY" | quote }}
          redmineSecretKeyBase: {{ requiredEnv "REDMINE_SECRET_KEY_BASE" | quote }}
          postgresPassword: {{ requiredEnv "POSTGRES_PASSWORD" | quote }}
          testAdminPassword: {{ env "TEST_ADMIN_PASSWORD" | quote }}
          testSupportPassword: {{ env "TEST_SUPPORT_PASSWORD" | quote }}
          testSalesPassword: {{ env "TEST_SALES_PASSWORD" | quote }}
